# ==============================================================================
# EVALUAR GEA - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# 1. ENTORNO LOCAL:
#    Copia este archivo como .env.local:
#    cp .env.example .env.local
#    (o en Windows: copy .env.example .env.local)
#
# 2. ENTORNO VERCEL (PRODUCCIÓN):
#    Ve a: https://vercel.com -> Selecciona tu proyecto -> Settings -> Environment Variables
#    Agrega cada una de las siguientes variables para los entornos: Production, Preview y Development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVÍO DE CORREOS (RESEND API)
# ------------------------------------------------------------------------------
# Obtén tu clave en https://resend.com/api-keys
# En Vercel, esta variable se usa de forma segura en el backend (/api/send-email)
RESEND_API_KEY=re_tu_api_key_de_resend_aqui

# Remitente de los correos automáticos.
# - Para pruebas iniciales sin dominio propio configurado:
#   RESEND_FROM_EMAIL=GEA Selección <onboarding@resend.dev>
# - Cuando agregues tu dominio oficial en Resend (ej. geaperu.pe):
#   RESEND_FROM_EMAIL=GEA Selección <seleccion@geaperu.pe>
RESEND_FROM_EMAIL=GEA Selección <onboarding@resend.dev>

